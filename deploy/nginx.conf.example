# Put this server block behind your own certificate management. Replace the
# example hostname and certificate paths before enabling it.
server {
    listen 443 ssl;
    server_name bambu.example.local;

    ssl_certificate /etc/ssl/bambu/fullchain.pem;
    ssl_certificate_key /etc/ssl/bambu/privkey.pem;

    location = /metrics {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:9208;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 660s;
    }
}
