# The hostname or IP address entered in the browser. Caddy includes this value
# in its local TLS certificate.
BAMBU_SITE_HOST=localhost

# Safe default: reachable only from the Docker host. For LAN access, use the
# server's LAN IP here or 0.0.0.0 and restrict port 9444 with the host firewall.
BAMBU_BIND_ADDRESS=127.0.0.1
BAMBU_HTTPS_PORT=9444

TZ=UTC
BAMBU_LOG_LEVEL=INFO
