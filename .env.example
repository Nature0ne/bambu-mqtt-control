# Published multi-architecture image (linux/amd64 and linux/arm64).
BAMBU_IMAGE=ghcr.io/nature0ne/bambu-mqtt-control:latest
BAMBU_PULL_POLICY=missing

# Hostname or IP address entered in the browser. Caddy includes this value in
# its local TLS certificate.
BAMBU_SITE_HOST=localhost

# Safe default: reachable only from the Docker host. For LAN access, use the
# server's LAN IP here or 0.0.0.0 and restrict port 9444 with the host firewall.
BAMBU_BIND_ADDRESS=127.0.0.1
BAMBU_HTTPS_PORT=9444

TZ=UTC
BAMBU_LOG_LEVEL=INFO

# Optional local-build metadata used by deploy/compose.build.yaml.
BAMBU_BUILD_IMAGE=bambu-mqtt-control:local
BAMBU_CONTROL_VERSION=dev
BAMBU_VCS_REF=local
BAMBU_BUILD_DATE=unknown
